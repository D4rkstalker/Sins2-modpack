{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "per_player",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_units_in_phase_lanes",
                "gravity_well_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "traveling_from_gravity_well_origin": true,
		"traveling_to_gravity_well_origin": true,
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "unit_passes_target_filter",
                        "unit":
                        {
                            "unit_type": "operand_destination"
                        },
                        "target_filter_id": "enhanced_tunneling_phase_jumping_target_filter"
                    },
                    "operator_type": "apply_buff",
                    "buff": "vasari_enhanced_tunneling_on_phase_jumping_unit"
                }]
            },
            {
                "action_type": "use_unit_operators_on_units_in_gravity_well_of_unit",
                "gravity_well_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "unit_passes_target_filter",
                        "unit":
                        {
                            "unit_type": "operand_destination"
                        },
                        "target_filter_id": "enhanced_tunneling_target_filter"
                    },
                    "operator_type": "apply_buff",
                    "buff": "vasari_enhanced_tunneling_on_unit_in_gravity_well"
                }]
	    }]
        }
    }]
}
