{
    "version": 0,
    "make_dead_on_source_ability_released": true,
	"make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_current_spawner_ownership_changed_from_buff_ownership": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
					"constraint":
					{
						"constraint_type": "unit_passes_target_filter",
						"unit":
						{
							"unit_type": "operand_destination"
						},
						"target_filter_id": "ancient_starbase_enemy_planet_target_filter"
					},
                    "operator_type": "bomb_planet",
                    "damage_source": "ability",
                    "bombing_damage_value": "bombing_damage_value",
                    "bombing_population_damage_value": "fixed_zero"
                }]
            }]
        }
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "action_data_source",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "dlc_ancient_starbase_planetary_shield_array_unit_item_on_planet_small",
                        "medium_unit": "dlc_ancient_starbase_planetary_shield_array_unit_item_on_planet_medium",
                        "large_unit": "dlc_ancient_starbase_planetary_shield_array_unit_item_on_planet_large"
                    }
                }
            }]
        }
    },
    {
        "trigger_event_type": "on_current_spawner_made_dead",
        "action_group":
        {
            "actions": [
            {
                "action_type": "make_buff_dead"
            }]
        }
    }],
    "unit_mutations": [
        "disable_can_be_colonized",
		"suppress_invulnerable"
    ],
    "gui":
    {
        "hud_icon": "dlc_ancient_starbase_planet_shield_unit_item_hud_icon",
        "name": "dlc_ancient_starbase_planet_shield_unit_item_name",
		"is_visible_within_unit_tooltip": true,
        "visibility_scope": "negative"
    }
}
