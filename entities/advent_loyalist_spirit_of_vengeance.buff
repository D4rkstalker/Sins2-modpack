{
    "version": 0,
    "make_dead_on_current_spawner_made_dead": false,
    "make_dead_on_source_ability_released": true,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_unit_damaged_by_current_spawner",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "damage_has_weapon_tag",
                "weapon_tag": "holy_fire"
            },
            "actions": [
            {
                "action_type": "use_unit_operators_on_units_in_radius_of_unit",
                "radius_origin_unit":
                {
                    "unit_type": "trigger_event_destination"
                },
                "include_radius_origin_unit": false,
                "radius_value": "spirit_of_vengeance_holy_fire_radius_value",
                "operators_constraint":
                {
                    "constraint_type": "unit_passes_target_filter",
                    "unit":
                    {
                        "unit_type": "operand_destination"
                    },
                    "target_filter_id": "spirit_of_vengeance_target_filter"
                },
                "operators": [
                {
                    "operator_type": "apply_damage",
                    "damage_source": "ability",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "spirit_of_vengeance_holy_fire_damage_value",
                    "penetration_value": "spirit_of_vengeance_holy_fire_pierce_value"
                },
                {
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "above",
                        "effect_by_size":
                        {
                            "small_unit": "spirit_of_vengeance_splash_small",
                            "medium_unit": "spirit_of_vengeance_splash_medium",
                            "large_unit": "spirit_of_vengeance_splash_large"
                        }
                    }
                }]
            }]
        }
    },
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "action_data_source",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                       "small_unit": "spirit_of_vengeance_ambient_small",
                       "medium_unit": "spirit_of_vengeance_ambient_medium",
                       "large_unit": "spirit_of_vengeance_ambient_large"
                    }
                }
            }]
        }
    },
    {
        "trigger_event_type": "on_current_spawner_made_dead",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_units_in_radius_of_unit",
                "radius_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "include_radius_origin_unit": false,
                "radius_value": "spirit_of_vengeance_radius_value",
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "unit_passes_target_filter",
                        "unit":
                        {
                            "unit_type": "operand_destination"
                        },
                        "target_filter_id": "spirit_of_vengeance_explosion_enemy_target_filter"
                    },
                    "operator_type": "apply_damage",
                    "damage_source": "ability",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "spirit_of_vengeance_enemy_damage_value",
                    "penetration_value": "spirit_of_vengeance_pierce_value",
                    "can_damage_be_propagated": false
                }]
            },
            {
                "action_type": "use_unit_operators_on_units_in_radius_of_unit",
                "radius_origin_unit":
                {
                    "unit_type": "current_spawner"
                },
                "include_radius_origin_unit": false,
                "radius_value": "spirit_of_vengeance_radius_value",
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "unit_passes_target_filter",
                        "unit":
                        {
                            "unit_type": "operand_destination"
                        },
                        "target_filter_id": "spirit_of_vengeance_explosion_friendly_target_filter"
                    },
                    "operator_type": "apply_damage",
                    "damage_source": "ability",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "spirit_of_vengeance_friendly_damage_value",
                    "penetration_value": "spirit_of_vengeance_pierce_value",
                    "can_damage_be_propagated": false
                }]
            },
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "action_data_source",
                        "mesh_point": "center",
                        "effect": "spirit_of_vengeance"
                    }
                },
                {
                    "operator_type": "make_dead"
                }]
            },
            {
                "action_type": "make_buff_dead"
            }]
        }
    }]
}
