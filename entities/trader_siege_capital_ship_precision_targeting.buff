                        "medium_unit": "trader_siege_capital_ship_precision_targeting_buff_on_target_medium",
                        "large_unit": "trader_siege_capital_ship_precision_targeting_buff_on_target_large"
                    }
                }
            }]
        }
    },
    {
        "trigger_event_type": "on_current_spawner_spawned_torpedo",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "trigger_event_destination"
                },
                "operators": [
                {
                    "operator_type": "apply_buff",
                    "buff": "trader_siege_capital_ship_precision_targeting_on_torpedo"
                }]
