{
    "version": 0,
    "active_duration": "scar_duration_value",
    "make_dead_on_current_spawner_made_dead": false,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "restart_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "apply_damage",
                    "damage_source": "ability",
                    "damage_affect_type": "hull_and_armor_and_shields",
                    "damage_value": "scar_value",
                    "penetration_value": "scar_penetration_value"
                }]
            }]
        }
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "start_buff_effect",
                "effect_definition":
                {
                    "binding": "action_data_source",
                    "mesh_point": "center",
                    "effect_by_size":
                    {
                        "small_unit": "psi_scar_on_target_small",
                        "medium_unit": "psi_scar_on_target_medium",
                        "large_unit": "psi_scar_on_target_large"
                    }
                }
            }]
        }
    }],
    "unit_modifiers": [
    {
        "buff_unit_modifier_id": "scar_shield_degen_modifier",
        "buff_unit_modifier_id": "scar_armor_degen_modifier",
        "buff_unit_modifier_id": "scar_hull_degen_modifier"
    }],
    "gui":
    {
        "hud_icon": "advent_psi_scar_hud_icon",
        "name": "research_subject.advent_loyalist_psi_scar_name",
        "visibility_scope": "negative",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.damage",
                "value_id": "scar_value",
                "value_color": "negative",
                "value_suffix": "per_second",
                "is_resolved_value": true
            },
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.armor_penetration",
                "value_id": "scar_penetration_value",
                "value_color": "negative"
            },
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "scar_shield_degen_modifier",
                "is_resolved_value": true
            },
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "scar_armor_degen_modifier",
                "is_resolved_value": true
            },
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "scar_hull_degen_modifier",
                "is_resolved_value": true
            }]
        }]
    }
}
