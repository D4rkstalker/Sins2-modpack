{
    "version": 0,
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "make_dead_on_current_spawner_made_dead": false,
    "make_dead_on_all_finite_time_actions_done": true,
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "first_action_delay_time_value": "fixed_minute",
        "execution_interval_value": "fixed_one",
        "execution_interval_count_value": "fixed_one",
        "action_group":
        {
            "actions": [
            {
                "action_type": "make_buff_dead"
            }]
        }
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_current_spawner_augment_pending_damage_as_source",
        "action_group":
        {
            "constraint":
            {
                "constraint_type": "unit_passes_target_filter",
                "unit":
                {
                    "unit_type": "trigger_event_destination"
                },
                "target_filter_id": "assault_specialization_target_filter"
            },
            "actions": [
            {
                "action_type": "augment_damage",
                "bonus_damage_value": "assault_specialization_torpedo_damage_value"
            }]
        }
    }]
}
