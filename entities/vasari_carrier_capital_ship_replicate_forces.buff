{
    "version": 0,
    "make_current_spawner_dead_on_buff_made_dead": true,
    "active_duration": "replicate_forces_duration_value",
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "restart_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "unit_modifiers": [
    {
        "buff_unit_modifier_id": "replicate_clone_armor_modifier"
    },
    {
        "buff_unit_modifier_id": "replicate_clone_hull_modifier"
    }],
    "trigger_event_actions": [
    {
        "trigger_event_type": "on_buff_started",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "operator_type": "play_point_effect",
                    "effect_definition":
                    {
                        "binding": "unit_skin",
                        "mesh_point": "center",
                        "effect_by_size":
                        {
                            "small_unit": "vasari_carrier_capital_ship_replicate_forces_impact_small",
                            "medium_unit": "vasari_carrier_capital_ship_replicate_forces_impact_medium",
                            "large_unit": "vasari_carrier_capital_ship_replicate_forces_impact_large"
                        }
                    }
                },
                {
                    "operator_type": "change_owner_player",
                    "new_owner_player":
                    {
                        "player_type": "unit_owner",
                        "owned_unit":
                        {
                            "unit_type": "first_spawner"
                        }
                    }
                }]
            }]
        }
    }],
    "gui":
    {
        "hud_icon": "vasari_carrier_capital_ship_replicate_forces_ability_hud_icon",
        "name": "vasari_carrier_capital_ship_replicate_forces_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "replicate_clone_armor_modifier"
            },
            {
                "rendering_type": "buff_unit_modifier",
                "unit_modifier_id": "replicate_clone_hull_modifier"
            }]
        }]
    }
}
