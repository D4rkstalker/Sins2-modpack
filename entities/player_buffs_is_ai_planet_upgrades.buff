                {
                    "player_type": "unit_owner",
                    "owned_unit":
                    {
                        "unit_type": "current_spawner"
                    }
                },
                "operators": [
                {
                    "constraint":
                    {
                        "constraint_type": "random_chance",
                        "chance_value": "planet_ai_random_chance_value"
                    },
                    "operator_type": "increase_planet_track_level",
                    "planet_track_type": "commerce",
                    "will_offset_development_track_upgrade_price": true,
                    "ignore_research": false
                },
                {
                    "constraint":
                    {
                        "constraint_type": "random_chance",
                        "chance_value": "planet_ai_random_chance_value"
                    },
                    "operator_type": "increase_planet_track_level",
