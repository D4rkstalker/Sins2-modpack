{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_distance_to_parent_buff_exceeded":
    {
        "distance": "microphasing_aura_radius"
    },
    "stacking_limit":
    {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
    {
        "execution_interval_value": "microphasing_aura_execution_interval_value",
        "action_group":
        {
            "actions": [
            {
                "action_type": "use_unit_operators_on_single_unit",
                "destination_unit":
                {
                    "unit_type": "current_spawner"
                },
                "operators": [
                {
                    "constraint":
                    {
			"constraint_type": "random_chance",
			"chance_value": "microphasing_aura_chance_value"
                    },
                    "operator_type": "apply_buff",
                    "buff": "grost_microphasing_aura_on_target"
                }]
            }]
        }
    }],
    "gui":
    {
        "hud_icon": "vasari_carrier_capital_ship_elite_bombers_ability_hud_icon",
        "name": "vasari_carrier_capital_ship_elite_bombers_ability_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
        {
            "lines": [
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.execution_chance",
                "value_id": "microphasing_aura_chance_value",
                "value_float_format": "percentage",
                "value_color": "positive"
            },
            {
                "rendering_type": "single_value",
                "label_text": "tooltip.ability.execution_interval",
                "value_id": "microphasing_aura_execution_interval_value",
                "value_suffix": "seconds",
                "value_color": "positive"
            }]
        }]
    }
}
